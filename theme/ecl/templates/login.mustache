{{!
    @template theme_ecl/login

    Custom split-screen login page.

    Context variables required:
    * sitename, logourl, loginbg, tagline
    * maincontent (login form HTML rendered by Moodle)
    * output, bodyattributes, currentyear
}}
<!DOCTYPE html>
<html {{{output.htmlattributes}}}>
<head>
    <title>{{output.page_title}}</title>
    <link rel="shortcut icon" href="{{output.favicon}}" />
    {{{output.standard_head_html}}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body {{{bodyattributes}}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">
    {{{output.standard_top_of_body_html}}}

    <main class="ecl-login-wrapper" data-testid="login-wrapper">
        {{! LEFT - Branding panel }}
        <aside class="ecl-login-aside" {{#loginbg}}style="background-image: linear-gradient(135deg, rgba(0,35,98,0.92), rgba(0,35,98,0.78)), url('{{loginbg}}'); background-size: cover; background-position: center;"{{/loginbg}}>
            <div class="brand">
                <img src="{{logourl}}" alt="{{sitename}}" data-testid="login-logo">
                <div class="text">
                    <div class="name">École de Commerce de Lyon</div>
                    <span class="campus">Campus Abidjan</span>
                </div>
            </div>

            <div class="ecl-login-tagline">
                <h1>{{tagline}}</h1>
                <p>{{#str}}login_pitch, theme_ecl{{/str}}</p>
            </div>

            <div class="ecl-login-foot">
                <span>© {{currentyear}} ECL Abidjan</span>
                <a href="#">{{#str}}help_center, theme_ecl{{/str}}</a>
                <a href="#">{{#str}}contact, theme_ecl{{/str}}</a>
            </div>
        </aside>

        {{! RIGHT - Form panel }}
        <section class="ecl-login-main">
            <div class="ecl-login-card" data-testid="login-card">
                <div class="ecl-login-mobile-brand">
                    <img src="{{logourl}}" alt="{{sitename}}">
                    <strong>ECL Abidjan</strong>
                </div>

                <h2>{{#str}}welcomeback, theme_ecl{{/str}}</h2>
                <p class="ecl-login-sub">{{#str}}welcomeback_sub, theme_ecl{{/str}}</p>

                {{{maincontent}}}
            </div>
        </section>
    </main>

    {{{output.standard_end_of_body_html}}}
</div>

{{#js}}
require(['theme_boost/loader']);
{{/js}}
</body>
</html>
