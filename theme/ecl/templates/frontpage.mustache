{{!
    @template theme_ecl/frontpage

    Custom frontpage - hero + slider + highlights + content + footer.

    Context variables required:
    * sitename, logourl
    * herotitle, herosubtitle, heroctalabel, heroctaurl, heroimage
    * slides (array), hasslides, sliderinterval
    * highlights (array), hashighlights
    * footercols (array), footnote
    * sidepreblocks, hasblocks
    * isloggedin, loginurl, dashboardurl, mycoursesurl, userpicture
    * output, bodyattributes
}}
<!DOCTYPE html>
<html {{{output.htmlattributes}}}>
<head>
    <title>{{output.page_title}}</title>
    <link rel="shortcut icon" href="{{output.favicon}}" />
    {{{output.standard_head_html}}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body {{{bodyattributes}}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">
    {{{output.standard_top_of_body_html}}}

    {{! ---------- TOP NAVBAR ---------- }}
    <header class="ecl-navbar-wrap">
        <nav class="navbar navbar-expand-lg fixed-top primary-navigation" data-testid="ecl-main-nav">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{output.config.wwwroot}}/" data-testid="ecl-brand">
                    <img src="{{logourl}}" alt="{{sitename}}" class="logo">
                    <span class="site-name d-none d-md-block">
                        École de Commerce de Lyon
                        <small>Campus Abidjan</small>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#eclMainNav" aria-controls="eclMainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa fa-bars"></i>
                </button>

                <div class="collapse navbar-collapse" id="eclMainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item"><a class="nav-link" href="{{output.config.wwwroot}}/" data-testid="nav-home">{{#str}}home{{/str}}</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{output.config.wwwroot}}/course/index.php" data-testid="nav-courses">{{#str}}courses{{/str}}</a></li>
                        {{#isloggedin}}
                        <li class="nav-item"><a class="nav-link" href="{{dashboardurl}}" data-testid="nav-dashboard">{{#str}}myhome,core{{/str}}</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{mycoursesurl}}" data-testid="nav-mycourses">{{#str}}mycourses,core{{/str}}</a></li>
                        {{/isloggedin}}
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        {{{output.lang_menu}}}
                        {{#isloggedin}}
                            {{{output.user_menu}}}
                        {{/isloggedin}}
                        {{^isloggedin}}
                            <a href="{{loginurl}}" class="btn btn-primary" data-testid="login-btn">
                                <i class="fa fa-sign-in-alt me-2"></i>{{#str}}login,core{{/str}}
                            </a>
                        {{/isloggedin}}
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="page" class="ecl-frontpage-main" style="padding-top: 96px;" data-testid="frontpage-main">

        {{! ---------- HERO ---------- }}
        <section class="ecl-hero" data-testid="ecl-hero">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <span class="ecl-hero-eyebrow">
                            <i class="fa fa-star"></i> {{#str}}herobadge, theme_ecl{{/str}}
                        </span>
                        <h1 class="ecl-hero-title">{{{herotitle}}}</h1>
                        <div class="ecl-hero-subtitle">{{{herosubtitle}}}</div>
                        <div class="ecl-hero-cta">
                            {{#heroctaurl}}
                            <a href="{{heroctaurl}}" class="btn btn-secondary btn-lg" data-testid="hero-cta-primary">
                                {{heroctalabel}} <i class="fa fa-arrow-right ms-2"></i>
                            </a>
                            {{/heroctaurl}}
                            <a href="{{output.config.wwwroot}}/course/index.php" class="btn btn-ecl-ghost btn-lg" data-testid="hero-cta-secondary">
                                <i class="fa fa-book-open me-2"></i>{{#str}}exploreprograms, theme_ecl{{/str}}
                            </a>
                        </div>

                        <div class="ecl-hero-stats">
                            <div class="stat">
                                <div class="num">25+</div>
                                <div class="label">{{#str}}stat_programs, theme_ecl{{/str}}</div>
                            </div>
                            <div class="stat">
                                <div class="num">3 000+</div>
                                <div class="label">{{#str}}stat_students, theme_ecl{{/str}}</div>
                            </div>
                            <div class="stat">
                                <div class="num">94%</div>
                                <div class="label">{{#str}}stat_employability, theme_ecl{{/str}}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! ---------- ANNOUNCEMENTS SLIDER ---------- }}
        {{#hasslides}}
        <section class="container" data-testid="announcements-section">
            <div class="d-flex justify-content-between align-items-end mb-3">
                <h2 class="ecl-section-title"><span class="bar"></span>{{#str}}announcements, theme_ecl{{/str}}</h2>
            </div>
            <div id="ecl-announcement-carousel" class="ecl-slider carousel slide" data-bs-ride="carousel" data-testid="announcement-carousel">
                <div class="carousel-indicators">
                    {{#slides}}
                    <button type="button" data-bs-target="#ecl-announcement-carousel"
                            data-bs-slide-to="{{index}}" {{#active}}class="active" aria-current="true"{{/active}}
                            aria-label="Slide {{index}}"></button>
                    {{/slides}}
                </div>

                <div class="carousel-inner">
                    {{#slides}}
                    <div class="carousel-item {{#active}}active{{/active}}">
                        <div class="ecl-slide-image" {{#imageurl}}style="background-image: url('{{imageurl}}');"{{/imageurl}}></div>
                        <div class="ecl-slide-content">
                            <span class="ecl-slide-eyebrow">{{#str}}announcement, theme_ecl{{/str}}</span>
                            <h2 class="ecl-slide-title">{{title}}</h2>
                            <div class="ecl-slide-caption">{{{caption}}}</div>
                            {{#url}}
                            <a href="{{url}}" class="ecl-slide-cta">
                                {{#str}}readmore, theme_ecl{{/str}} <i class="fa fa-arrow-right"></i>
                            </a>
                            {{/url}}
                        </div>
                    </div>
                    {{/slides}}
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#ecl-announcement-carousel" data-bs-slide="prev">
                    <span class="ecl-arrow"><i class="fa fa-chevron-left"></i></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#ecl-announcement-carousel" data-bs-slide="next">
                    <span class="ecl-arrow"><i class="fa fa-chevron-right"></i></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </section>
        {{/hasslides}}

        {{! ---------- HIGHLIGHTS ---------- }}
        {{#hashighlights}}
        <section class="container ecl-highlights" data-testid="highlights-section">
            <h2 class="ecl-section-title"><span class="bar"></span>{{#str}}whychoose, theme_ecl{{/str}}</h2>
            <p class="ecl-section-lead">{{#str}}whychoose_lead, theme_ecl{{/str}}</p>
            <div class="row g-4">
                {{#highlights}}
                <div class="col-md-6 col-lg-3">
                    <div class="ecl-highlight-card" data-testid="highlight-card">
                        <span class="icon"><i class="fa {{icon}}"></i></span>
                        <h3>{{title}}</h3>
                        <div>{{{text}}}</div>
                        {{#url}}
                        <a href="{{url}}" class="ecl-link">{{#str}}learnmore, theme_ecl{{/str}} <i class="fa fa-arrow-right"></i></a>
                        {{/url}}
                    </div>
                </div>
                {{/highlights}}
            </div>
        </section>
        {{/hashighlights}}

        {{! ---------- SITE MAIN CONTENT (course list, news, etc.) ---------- }}
        <section class="container ecl-courses-block-wrap" data-testid="frontpage-content">
            <div class="row">
                <div class="{{#hasblocks}}col-lg-9{{/hasblocks}}{{^hasblocks}}col-12{{/hasblocks}}">
                    {{{output.course_content_header}}}
                    {{{output.main_content}}}
                    {{{output.activity_navigation}}}
                    {{{output.course_content_footer}}}
                </div>
                {{#hasblocks}}
                <aside class="col-lg-3" data-testid="frontpage-blocks">
                    {{{sidepreblocks}}}
                    {{{addblockbutton}}}
                </aside>
                {{/hasblocks}}
            </div>
        </section>

        {{! ---------- FOOTER ---------- }}
        <footer id="page-footer" class="ecl-footer" data-testid="ecl-footer">
            <div class="ecl-footer-main">
                <div class="container">
                    <div class="row g-5">
                        <div class="col-lg-3 col-md-6">
                            <div class="ecl-footer-brand">
                                <img src="{{logourl}}" alt="{{sitename}}">
                                <div class="name">
                                    École de Commerce de Lyon
                                    <small>Campus Abidjan</small>
                                </div>
                            </div>
                            <p class="ecl-footer-tagline">{{#str}}footer_tagline, theme_ecl{{/str}}</p>
                        </div>

                        {{#footercols}}
                        <div class="col-lg-2 col-md-6 ecl-footer-col">
                            <h5>{{title}}</h5>
                            <div>{{{content}}}</div>
                        </div>
                        {{/footercols}}
                    </div>
                </div>
            </div>

            <div class="ecl-footer-bottom">
                <div class="container">
                    <div class="ecl-footer-bottom-inner">
                        <div>{{{footnote}}}</div>
                        <div class="moodle-credit">
                            {{#str}}poweredby, theme_ecl{{/str}}
                            <a href="https://moodle.org" target="_blank" rel="noopener">Moodle</a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </main>

    {{{output.standard_after_main_regions_html}}}
    {{{output.standard_end_of_body_html}}}
</div>

{{#js}}
require(['theme_boost/loader']);
require(['jquery'], function($) {
    $(function () {
        var $car = $('#ecl-announcement-carousel');
        if ($car.length && typeof $car.carousel === 'function') {
            $car.carousel({
                interval: {{sliderinterval}},
                pause: 'hover',
                ride: 'carousel'
            });
        }
    });
});
{{/js}}
</body>
</html>
